ADMIN_PASSWORD=change-this-admin-password
LINK_SECRET=replace-with-at-least-32-random-characters

# Preferred on Vercel: paste the YAML text into this env var.
# YAML_CONTENT=

# Local alternative: create data/subscription.yaml. Do not put it in public/.
YAML_FILE_PATH=data/subscription.yaml

# Optional. Prevents accidentally creating links that live forever.
MAX_LINK_TTL_DAYS=365
