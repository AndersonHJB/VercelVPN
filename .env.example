ADMIN_PASSWORD=change-this-admin-password
LINK_SECRET=replace-with-at-least-32-random-characters

# Keep each existing deployment's LINK_SECRET unchanged when migrating old links.
# GitHub storage is optional. Enable BOTH REPO and TOKEN to use shared storage.
# Use the same private repo, branch and path in both deployments.
# Initialize the repository first: the selected branch (default main) must exist.
# Fine-grained PAT: select only the data repo, with Contents: Read and write.
# Server-only values. Never use NEXT_PUBLIC_ or commit a real token.
# GITHUB_STORAGE_REPO=AndersonHJB/vpn-userdata
# GITHUB_STORAGE_TOKEN=replace-with-your-fine-grained-pat
# GITHUB_STORAGE_BRANCH=main
# GITHUB_STORAGE_PATH=subscriptions/links.json

# With GitHub configured: new subscriptions are persisted, renewal keeps the URL,
# and storage failures return 503. After entering the admin password, the page
# reads shared records once; further reads follow management actions or Refresh.
# The two existing domains have already migrated their browser history.

# YAML source priority:
# 1. YAML_CONTENT
# 2. YAML_SOURCE_URL
# 3. YAML_FILE_PATH

# Option A: paste the YAML text into this env var.
# YAML_CONTENT=

# Option B: fetch YAML from an upstream URL.
# YAML_SOURCE_URL=https://example.com/path/to/subscription.yaml

# Option C: local file. This may be a YAML file, or a text file containing one
# http(s) URL that points to the upstream YAML. Do not put either in public/.
YAML_FILE_PATH=data/subscription.yaml
# YAML_FILE_PATH=data/iggfeed.txt

# Optional. Prevents accidentally creating links that live forever.
MAX_LINK_TTL_DAYS=365

# Legacy local revocation store. Preserve existing settings during migration.
# When GitHub storage is disabled, Vercel needs KV/Upstash for persistent revocation.
# Existing revocations are still checked when GitHub storage is enabled.
REVOKED_LINKS_FILE_PATH=data/revoked-links.json
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# LINK_REVOCATION_UPSTASH_REST_URL=
# LINK_REVOCATION_UPSTASH_REST_TOKEN=
