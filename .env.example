ADMIN_PASSWORD=change-this-admin-password
LINK_SECRET=replace-with-at-least-32-random-characters

# YAML source priority:
# 1. YAML_CONTENT
# 2. YAML_SOURCE_URL
# 3. YAML_FILE_PATH

# Option A: paste the YAML text into this env var.
# YAML_CONTENT=

# Option B: fetch YAML from an upstream URL.
# YAML_SOURCE_URL=https://example.com/path/to/subscription.yaml

# Option C: local file. Create data/subscription.yaml. Do not put it in public/.
YAML_FILE_PATH=data/subscription.yaml

# Optional. Prevents accidentally creating links that live forever.
MAX_LINK_TTL_DAYS=365

# Local revocation store for invalidated single links.
# Vercel deployments should use KV_REST_API_URL/KV_REST_API_TOKEN or the custom
# LINK_REVOCATION_UPSTASH_REST_URL/LINK_REVOCATION_UPSTASH_REST_TOKEN pair instead.
REVOKED_LINKS_FILE_PATH=data/revoked-links.json
